# Base URL of the Rails portfolio API (see server/).
#
# Leave this unset and the site still works: every live section falls back to
# the bundled snapshot in src/data/. Set it to turn the GitHub feed on.
#
# Local development (with `cd server && bin/rails server -p 3001`):
VITE_API_URL=http://localhost:3001

# Production, e.g.
# VITE_API_URL=https://bharat-portfolio-api.onrender.com


# ---- Contact form (EmailJS) -------------------------------------------------
#
# All three are required for the form to send in-page. Get them from your EmailJS
# dashboard - see EMAILJS_SETUP.md for the walkthrough.
#
# Leave them unset and the form still works: it opens the visitor's own mail
# client with the message pre-filled instead of sending silently.
#
# These are compiled into the public JS bundle, so only ever put the EmailJS
# *public* key here - never the private key.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
