# GitHub account to pull projects and stats from.
GITHUB_USERNAME=rudra1819

# Optional but recommended. Unauthenticated GitHub requests are capped at
# 60/hour per IP; a token raises that to 5,000/hour. Only public repository data
# is read, so create a fine-grained token with NO scopes selected:
#   https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Browser origins allowed to call this API (comma separated). Local Vite ports
# are permitted automatically in development.
ALLOWED_ORIGINS=https://your-portfolio.vercel.app

# How long a sync stays fresh. Past this, the next request serves cached data
# and triggers a background refresh.
SYNC_TTL_MINUTES=60

# Shared secret for POST /api/v1/sync. Generate with `bin/rails secret`.
# The endpoint returns 403 until this is set.
SYNC_TOKEN=

# When the first professional role began, used for the "Years Experience" stat.
# GitHub cannot know this.
CAREER_START_DATE=2024-12-01

# Provided by the host in production (Render, Fly.io, Railway all inject it).
# DATABASE_URL=postgres://user:pass@host:5432/portfolio_api_production

# Required in production. Generate with `bin/rails secret`.
# SECRET_KEY_BASE=
